<Application x:Class="MixedMediaPrint.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MixedMediaPrint.App.ViewModels"
             xmlns:views="clr-namespace:MixedMediaPrint.App.Views"
             xmlns:conv="clr-namespace:MixedMediaPrint.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- ViewModel-first navigation: ShellViewModel.CurrentViewModel is bound to a
                 ContentControl (see MainWindow.xaml); WPF picks the matching DataTemplate
                 below by the bound object's runtime type and renders that View, with the
                 View's DataContext automatically set to the ViewModel instance. -->
            <DataTemplate DataType="{x:Type vm:PrinterSetupViewModel}">
                <views:PrinterSetupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalibrationViewModel}">
                <views:CalibrationTestPrintView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JobSetupViewModel}">
                <views:JobSetupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RunViewModel}">
                <views:RunView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
