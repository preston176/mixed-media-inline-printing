<UserControl x:Class="MixedMediaPrint.App.Views.PrinterSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="1. Printer Setup" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshPrintersCommand}" Padding="10,4" Margin="8,0,0,0"/>
                <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" />
            </DockPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding FingerprintWarning}" Foreground="DarkOrange" TextWrapping="Wrap" FontWeight="Bold"
                       Visibility="{Binding FingerprintWarning, Converter={StaticResource NullToCollapsedConverter}}" Margin="0,0,0,8"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Input bins (trays)" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding Bins}" Height="100">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Media types" FontWeight="Bold" Margin="0,8,0,0"/>
                    <ListBox ItemsSource="{Binding MediaTypes}" Height="100">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Device info" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding DeviceInfo}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Scenarios (tab tray + body tray combination)" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" Height="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTrayPattern}" FontFamily="Consolas"/>
                                    <TextBlock Text=" -> body: "/>
                                    <TextBlock Text="{Binding BodyTrayPattern}" FontFamily="Consolas"/>
                                    <TextBlock Text=" flipX="/>
                                    <TextBlock Text="{Binding FlipX}"/>
                                    <TextBlock Text=" flipY="/>
                                    <TextBlock Text="{Binding FlipY}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Remove selected scenario" Command="{Binding RemoveScenarioCommand}"
                            CommandParameter="{Binding SelectedScenario}" Margin="0,4,0,0" HorizontalAlignment="Left"/>

                    <TextBlock Text="Add a new scenario" FontWeight="Bold" Margin="0,16,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tab tray pattern:" Margin="0,2,8,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewTabTrayPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Body tray pattern:" Margin="0,2,8,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewBodyTrayPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox Content="Flip X" IsChecked="{Binding NewFlipX}" Margin="0,0,16,0"/>
                            <CheckBox Content="Flip Y" IsChecked="{Binding NewFlipY}" Margin="0,0,16,0"/>
                            <TextBlock Text="Nudge X (in):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding NewNudgeXIn, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0"/>
                            <TextBlock Text="Nudge Y (in):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding NewNudgeYIn, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </StackPanel>

                        <Button Grid.Row="3" Grid.Column="1" Content="Add scenario" Command="{Binding AddScenarioCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"/>
                    </Grid>

                    <Button Content="Verify per-page tray switching (self-test, no paper)" Command="{Binding RunSelfTestCommand}"
                            Margin="0,16,0,4" Padding="10,4" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding SelfTestOutput}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Button Content="Continue to Calibration ->" Command="{Binding ContinueCommand}"
                    HorizontalAlignment="Right" Margin="0,24,0,0" Padding="14,6" FontWeight="Bold"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
