<UserControl x:Class="MixedMediaPrint.App.Views.CalibrationTestPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="2. Calibration" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border BorderBrush="Gray" BorderThickness="1">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="520"/>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Tab number:" Margin="0,4,0,2"/>
            <TextBox Text="{Binding TabNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Label text:" Margin="0,8,0,2"/>
            <TextBox Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Rotation (degrees):" Margin="0,8,0,2"/>
            <TextBox Text="{Binding RotationDegrees, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Nudge X (in):" Margin="0,8,0,2"/>
            <TextBox Text="{Binding NudgeXIn, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Nudge Y (in):" Margin="0,8,0,2"/>
            <TextBox Text="{Binding NudgeYIn, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Flip X" IsChecked="{Binding FlipX}" Margin="0,0,16,0"/>
                <CheckBox Content="Flip Y" IsChecked="{Binding FlipY}"/>
            </StackPanel>

            <TextBlock Text="Rotation sign is not hardware-confirmed for GDI+ yet -- eyeball the preview, then confirm on a real test print."
                       TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,12,0,0" FontStyle="Italic"/>

            <Button Content="Print test tab (dry-run, no paper)" Command="{Binding PrintTestTabDryRunCommand}"
                    Margin="0,16,0,0" Padding="10,6"/>

            <Separator Margin="0,16"/>

            <Button Content="Save &amp; Continue to Job Setup ->" Command="{Binding SaveAndContinueCommand}"
                    Padding="10,6" FontWeight="Bold"/>
            <Button Content="&lt;- Back" Command="{Binding BackCommand}" Margin="0,8,0,0" Padding="10,6" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>
